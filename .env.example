# Urban Traffic Intelligence Platform - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# CHICAGO DATA PORTAL
# ============================================================================
# Get your App Token from: https://data.cityofchicago.org/profile/edit/developer_settings
# Note: This is OPTIONAL - the app works without it (just with lower rate limits)
CHICAGO_DATA_PORTAL_APP_TOKEN=your_chicago_app_token_here

# ============================================================================
# WEATHER API
# ============================================================================
# Get your free API key from: https://openweathermap.org/api
# Note: This is OPTIONAL - use --synthetic-weather flag for testing without API key
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string
# Default for Docker: postgresql://postgres:postgres@postgres:5432/traffic_db
# Local development: postgresql://postgres:postgres@localhost:5432/traffic_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/traffic_db

# ============================================================================
# VECTOR DATABASE (QDRANT)
# ============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=traffic_documents

# ============================================================================
# OPENAI (for RAG - Phase 4)
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Note: Only needed for Phase 4 (RAG pipeline) onwards
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ============================================================================
# MLFLOW (Experiment Tracking)
# ============================================================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=traffic_forecasting

# ============================================================================
# API SETTINGS
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================================
# INGESTION SETTINGS
# ============================================================================
INGESTION_BATCH_SIZE=10000
MAX_RECORDS_PER_REQUEST=50000

# ============================================================================
# MODEL SETTINGS
# ============================================================================
FORECAST_HORIZON_HOURS=24
RETRAIN_THRESHOLD_MAE=5.0

# ============================================================================
# RAG SETTINGS
# ============================================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
MIN_RETRIEVAL_SCORE=0.7

# ============================================================================
# LOCATION (Chicago coordinates)
# ============================================================================
CHICAGO_LAT=41.8781
CHICAGO_LON=-87.6298
